{
  "manifest_version": 2,
  "name": "GeminiControllerFlow",
  "version": "1.0.18",
  "default_locale": "pt_BR",
  "description": "__MSG_extensionDescription__",
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "permissions": [
    "<all_urls>",
    "tabs",
    "activeTab",
    "storage",
    "webRequest",
    "webRequestBlocking"
  ],
  "browser_action": {
    "default_title": "__MSG_actionTitle__",
    "default_icon": "icons/icon.svg"
  },
  "content_scripts": [
    {
      "matches": [
        "https://gemini.google.com/*"
      ],
      "js": [
        "content/gemini-bridge.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/panel-host.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "commands": {
    "_execute_browser_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y"
      },
      "description": "__MSG_commandDescription__"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "geminicontrollerflow@local",
      "strict_min_version": "115.0",
      "update_url": "https://raw.githubusercontent.com/leccorside/GeminiControllerFlow/main/updates/updates.json",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "web_accessible_resources": [
    "panel/panel.html"
  ]
}
